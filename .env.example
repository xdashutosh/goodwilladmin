# Admin panel (Vite) environment variables.
# In Vercel: Project → Settings → Environment Variables. Vite inlines VITE_*
# vars at BUILD time, so set them before deploying.

# Base URL of the deployed backend API (NO trailing slash).
VITE_API_URL=https://goodwillprinters.onrender.com

# Public URL of the live storefront (used for "View product" links in enquiries).
VITE_FRONTEND_URL=https://www.plan-a-day.com
